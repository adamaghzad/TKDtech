# Public application URL used in QR pairing codes
APP_PUBLIC_URL=http://192.168.1.10:3000
PORT=3000
WEB_INTERNAL_URL=http://127.0.0.1:3001
TKD_DATABASE_PATH=./data/tkd-scoring.db
TKD_MODE=LOCAL
NEXT_PUBLIC_TKD_MODE=LOCAL
# Development only. Never enable either flag on an official production database.
SEED_DEVELOPMENT=true
ALLOW_DEMO_LOGIN=true
PAIRING_TOKEN_TTL_SECONDS=300
PRESENCE_EXPIRY_SECONDS=15
# The portable Electron launcher overrides these to require desktop activation.
# Leave licensing disabled for the development showcase and hosted cloud deployment.
TKD_DESKTOP_LICENSE_REQUIRED=false
TKD_LICENSE_DIRECTORY=./data/license
# Owner-only license issuer; never use a NEXT_PUBLIC_* variable or commit the key.
TKD_LICENSE_PRIVATE_KEY=/secure/path/ed25519-private.pem
# Cloud mode (never expose SUPABASE_SERVICE_ROLE_KEY through NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
