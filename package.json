{
  "name": "tkd-scoring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TKD Scoring by ADAM AGHZAF — TKDTech Sports Management",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n LOCAL,WEB -c green,cyan \"tsx watch apps/local-server/src/index.ts\" \"wait-on tcp:127.0.0.1:3000 && next dev apps/web -p 3001 -H 127.0.0.1\"",
    "dev:web": "next dev apps/web -p 3001 -H 127.0.0.1",
    "dev:local": "tsx watch apps/local-server/src/index.ts",
    "start": "concurrently -n LOCAL,WEB -c green,cyan \"tsx apps/local-server/src/index.ts\" \"wait-on tcp:127.0.0.1:3000 && next start apps/web -p 3001 -H 127.0.0.1\"",
    "build": "next build apps/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/web apps/local-server packages tests scripts desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "validate:migrations": "tsx scripts/validate-migrations.ts",
    "validate:supabase": "bash scripts/validate-supabase.sh",
    "backup": "tsx scripts/backup.ts",
    "license:issue": "tsx scripts/issue-license.ts",
    "check:database": "tsx scripts/check-database.ts",
    "check:supabase": "tsx scripts/check-supabase.ts",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:package": "node desktop/scripts/build-windows.mjs",
    "test:desktop:runtime": "node scripts/smoke-desktop-runtime.mjs",
    "test:license:delivery": "tsx scripts/smoke-license-delivery.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:migrations && npm run desktop:build && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@types/pdfkit": "^0.17.7",
    "better-sqlite3": "^11.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-proxy": "^1.18.1",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wait-on": "^9.5.1",
    "yazl": "^3.3.1"
  }
}
